generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  DOCTOR
  RECEPTIONIST
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  MISSED
}

enum QueueStatus {
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  MISSED
}

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
  APPOINTMENT_REMINDER
  APPOINTMENT_MISSED
  PATIENT_CHECKED_IN
  QUEUE_UPDATED
  PATIENT_CALLED
  CONSULTATION_STARTED
  CONSULTATION_COMPLETED
  APPOINTMENT_CONFLICT
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String @map("password_hash")

  // Password reset
  resetPasswordToken     String?   @map("reset_password_token")
  resetPasswordExpiresAt DateTime? @map("reset_password_expires_at")

  // Patient email verification
  emailVerified              Boolean   @default(false) @map("email_verified")
  emailVerificationToken     String?   @unique @map("email_verification_token")
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at")

  role      UserRole
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient      Patient?
  doctor       Doctor?
  receptionist Receptionist?

  notifications   Notification[]
  staffShifts     StaffShift[]
  shiftExceptions StaffShiftException[]

  @@map("users")
}

model Patient {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique @map("user_id")
  patientNumber String?  @unique @map("patient_number")
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  idNumber      String?  @unique @map("id_number")
  dob           DateTime
  phone         String
  address       String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("patients")
}

model Doctor {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique @map("user_id")
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  speciality String
  licenseNo  String   @unique @map("license_no")
  phone      String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  departments   DoctorDepartment[]
  appointments  Appointment[]
  consultations Consultation[]

  @@map("doctors")
}

model Receptionist {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  phone     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("receptionists")
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  doctors           DoctorDepartment[]
  appointments      Appointment[]
  consultationTypes ConsultationType[]

  @@map("departments")
}

model DoctorDepartment {
  doctorId     Int @map("doctor_id")
  departmentId Int @map("department_id")

  doctor     Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([doctorId, departmentId])
  @@map("doctor_department")
}

model Appointment {
  id           Int               @id @default(autoincrement())
  patientId    Int               @map("patient_id")
  doctorId     Int               @map("doctor_id")
  departmentId Int               @map("department_id")
  date         DateTime
  timeSlot     String            @map("time_slot")
  reason       String
  status       AppointmentStatus
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  consultationTypeId Int? @map("consultation_type_id")
  durationMinutes    Int? @map("duration_minutes")

  patient          Patient           @relation(fields: [patientId], references: [id])
  doctor           Doctor            @relation(fields: [doctorId], references: [id])
  department       Department        @relation(fields: [departmentId], references: [id])
  queue            Queue?
  consultation     Consultation?
  consultationType ConsultationType? @relation(fields: [consultationTypeId], references: [id], onDelete: Restrict)

  notifications Notification[]

  @@map("appointments")
}

model Queue {
  id            Int         @id @default(autoincrement())
  appointmentId Int         @unique @map("appointment_id")
  queueNumber   Int         @map("queue_number")
  status        QueueStatus
  checkedInAt   DateTime?   @map("checked_in_at")
  calledAt      DateTime?   @map("called_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("queue")
}

model Consultation {
  id            Int       @id @default(autoincrement())
  appointmentId Int       @unique @map("appointment_id")
  doctorId      Int       @map("doctor_id")
  notes         String
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor      Doctor      @relation(fields: [doctorId], references: [id])

  @@map("consultation")
}

model Notification {
  id            Int              @id @default(autoincrement())
  userId        Int              @map("user_id")
  appointmentId Int?             @map("appointment_id")
  type          NotificationType
  title         String
  message       String
  data          Json?
  dedupeKey     String?          @unique @map("dedupe_key")
  readAt        DateTime?        @map("read_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([appointmentId])
  @@map("notifications")
}

model StaffShift {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  dayOfWeek Int      @map("day_of_week")
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek, isActive])
  @@map("staff_shifts")
}

enum StaffShiftExceptionMode {
  REPLACE
  ADD
}

model StaffShiftException {
  id        Int                     @id @default(autoincrement())
  userId    Int                     @map("user_id")
  date      DateTime                @db.Date
  mode      StaffShiftExceptionMode
  reason    String?
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")

  user    User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  periods StaffShiftExceptionPeriod[]

  @@unique([userId, date])
  @@map("staff_shift_exceptions")
}

model StaffShiftExceptionPeriod {
  id          Int    @id @default(autoincrement())
  exceptionId Int    @map("exception_id")
  startTime   String @map("start_time")
  endTime     String @map("end_time")

  exception StaffShiftException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)

  @@map("staff_shift_exception_periods")
}

model ConsultationType {
  id              Int      @id @default(autoincrement())
  departmentId    Int      @map("department_id")
  name            String
  description     String
  durationMinutes Int      @map("duration_minutes")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  appointments Appointment[]

  @@unique([departmentId, name])
  @@index([departmentId, isActive])
  @@map("consultation_types")
}
